---
import { publicationUrl, type Publication } from '../data/publications';
import PublicationDate from './PublicationDate.astro';
import TaxonomyLinks from './TaxonomyLinks.astro';
interface Props { publications: Publication[]; featureFirst?: boolean; }
const { publications, featureFirst = false } = Astro.props;
---
<div class="publication-list">
  {publications.map((entry, index) => (
    <article class:list={['publication-row', { 'publication-feature': featureFirst && index === 0 }]}>
      <div class="publication-marker">
        {featureFirst && index === 0 && <p class="eyebrow">Dernière publication</p>}
        <span class="publication-number">{entry.data.episodeNumber}</span>
        <span class="publication-format">{entry.collection === 'notes' ? 'Note' : 'Dossier'}</span>
        <PublicationDate publishDate={entry.data.publishDate} updatedDate={entry.data.updatedDate} />
      </div>
      <div class="publication-body">
        <h2><a href={publicationUrl(entry)}>{entry.data.title}</a></h2>
        <p class="publication-description">{'cardDescription' in entry.data ? entry.data.cardDescription : entry.data.description}</p>
        <TaxonomyLinks themes={entry.data.themes} mechanisms={entry.data.mechanisms} />
        {featureFirst && index === 0 && <a class="text-link" href={publicationUrl(entry)}>Lire {entry.collection === 'notes' ? 'la note' : 'le dossier'} <span aria-hidden="true">↗</span></a>}
      </div>
    </article>
  ))}
</div>
