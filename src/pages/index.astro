---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Accueil">
  
  <section class="hero">
    <h2 class="manifesto-title">Ce que l'on ne voit pas <br/> structure l'œuvre.</h2>
    
    <div class="manifesto-text">
      <p>
        <strong>EN CREUX</strong> explore ce qui fait sens. Perspectives. Récits. Références. En creux, l'essentiel apparaît à travers les éléments contextuels cachés dans les œuvres culturelles et artistiques.
      </p>
    </div>
  </section>

  <section class="latest-episode">
    <div class="video-placeholder">
      <span class="play-btn">▶</span>
    </div>
    
    <div class="episode-info">
      <span class="episode-tag">Épisode Pilote</span>
      <h3>Les mécaniques invisibles</h3>
      <p>Une plongée dans la structure cachée de la création contemporaine. Comment l'absence de certains éléments redéfinit la portée d'une œuvre.</p>
      <a href="/episodes" class="btn">Voir l'épisode</a>
    </div>
  </section>

</MainLayout>

<style>
  .hero {
    margin-top: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .manifesto-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    margin-bottom: var(--space-md);
    max-width: 85%;
    line-height: 0.95;
  }

  .manifesto-text p {
    font-size: 1.2rem;
    max-width: 55ch;
    margin-left: auto;
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-md);
    color: var(--color-muted);
  }

  .manifesto-text strong {
    color: var(--color-text);
  }

  .latest-episode {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-lg);
    align-items: center;
    margin-bottom: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid rgba(10, 10, 10, 0.1);
  }

  .video-placeholder {
    background-color: #EAEAE6;
    aspect-ratio: 16/9;
    display: flex;
    justify-content: center;
    align-items: center;
    border: 1px solid rgba(10, 10, 10, 0.15);
    transition: border-color 0.2s ease;
    cursor: pointer;
  }

  .video-placeholder:hover {
    border-color: var(--color-text);
  }

  .play-btn {
    font-size: 2.5rem;
    color: var(--color-accent);
    transition: transform 0.2s ease;
  }

  .video-placeholder:hover .play-btn {
    transform: scale(1.08);
  }

  .episode-tag {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.5rem;
  }

  .episode-info h3 {
    font-size: 2rem;
    margin-bottom: var(--space-sm);
    letter-spacing: -0.01em;
  }

  .episode-info p {
    color: var(--color-muted);
    font-size: 1rem;
    margin-bottom: var(--space-md);
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    background-color: var(--color-text);
    color: var(--color-bg);
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
    transition: background-color 0.2s ease;
  }

  .btn:hover {
    background-color: var(--color-accent);
    color: var(--color-bg);
  }

  @media (max-width: 900px) {
    .manifesto-title {
      max-width: 100%;
    }
    .manifesto-text p {
      margin-left: 0;
    }
    .latest-episode {
      grid-template-columns: 1fr;
    }
  }
</style>