---
import MainLayout from '../layouts/MainLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import Discovery from '../components/Discovery.astro';
import { getPublications } from '../data/publications';
const publications = await getPublications();
---
<MainLayout title="Accueil">
  <section class="hero">
    <p class="eyebrow">EN CREUX.</p>
    <h1>Ce que les œuvres racontent <em>sans le dire.</em></h1>
    <p class="hero-intro">Œuvres, objets, pratiques culturelles : nous explorons leurs mécanismes, les contextes qui les façonnent et les significations qui leur échappent parfois.</p>
  </section>
  <section aria-label="Publications, de la plus récente à la plus ancienne">
    <PublicationList publications={publications} featureFirst />
  </section>
  <div class="discovery-grid">
    <section><h2><a href="/themes/">Explorer par thème</a></h2><Discovery publications={publications} kind="themes" /></section>
    <section><h2><a href="/mecanismes/">Explorer par mécanisme</a></h2><Discovery publications={publications} kind="mechanisms" /></section>
  </div>
</MainLayout>
