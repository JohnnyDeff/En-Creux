---
import MainLayout from '../../layouts/MainLayout.astro';
import PublicationList from '../../components/PublicationList.astro';
import { getPublications } from '../../data/publications';
const publications = (await getPublications()).filter(p => p.collection === 'notes');
---
<MainLayout title="Notes">
  <section class="listing-page">
    <div class="page-intro"><p class="eyebrow">Notes</p><h1>Courtes. Précises. <em>En creux.</em></h1></div>
    <PublicationList publications={publications} />
  </section>
</MainLayout>
