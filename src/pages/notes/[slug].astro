---
import { getCollection, render } from 'astro:content';
import TaxonomyLinks from '../../components/TaxonomyLinks.astro';
import PublicationDate from '../../components/PublicationDate.astro';
import MainLayout from '../../layouts/MainLayout.astro';

import bayeuxImage from '../../assets/images/bayeux.png';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const verification = (await getCollection('verifications')).find((entry) => entry.id === note.id);
const Verification = verification ? (await render(verification)).Content : null;
// Illustration propre à Bayeux : ajouter ici une correspondance explicite pour toute autre note illustrée.
const articleImage = note.id === 'tapisserie-de-bayeux' ? bayeuxImage : null;
---
<MainLayout title={note.data.title} description={note.data.description}>
  <article class="article-page">
    <header class="article-header">
      <div class="article-meta"><span>{note.data.episodeNumber}</span><span>Note</span></div>
      <h1>{note.data.title}</h1>
      <p class="article-description">{note.data.description}</p>
      <PublicationDate publishDate={note.data.publishDate} updatedDate={note.data.updatedDate} />
      <button class="share-button" type="button" id="copy-link">
        Copier le lien
      </button>
      <TaxonomyLinks themes={note.data.themes} mechanisms={note.data.mechanisms} />
    </header>
    {articleImage && (
      <img
        src={articleImage.src}
        alt="La tapisserie de Bayeux"
        class="article-image"
      />
    )}
    <div class="article-content">
      <Content />
      {note.id === 'tapisserie-de-bayeux' && (
        <aside class="article-documentation">
          <a class="text-link" href="/notes/tapisserie-de-bayeux/appareil-documentaire/">Consulter l’appareil documentaire</a>
        </aside>
      )}
    </div>
    {Verification && (
      <aside class="dossier-verification note-verification" aria-labelledby="verification-title">
        <p class="eyebrow">Méthode & sources</p>
        <h2 id="verification-title">{verification.data.title}</h2>
        <div class="verification-content"><Verification /></div>
      </aside>
    )}
  </article>
</MainLayout>

<script>
  const copyLinkButton = document.querySelector<HTMLButtonElement>('#copy-link');

  copyLinkButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      copyLinkButton.textContent = 'Lien copié';
    } catch {
      copyLinkButton.textContent = 'Copie impossible';
    }
  });
</script>
