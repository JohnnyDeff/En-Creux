---
import { getCollection, getEntry, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const dossiers = await getCollection('dossiers');
  return dossiers.map((dossier) => ({ params: { slug: dossier.id }, props: { dossier } }));
}

const { dossier } = Astro.props;
const { Content } = await render(dossier);
const verification = await getEntry('verifications', dossier.id);
const Verification = verification ? (await render(verification)).Content : null;
---
<MainLayout
  title={dossier.data.title}
  fullTitle={`${dossier.data.title} — ${dossier.data.subtitle} | EN CREUX`}
  description={dossier.data.description}
>
  <article class="article-page dossier-page">
    <header class="article-header">
      <p class="eyebrow">Dossier</p>
      <h1>{dossier.data.title}</h1>
      <p class="dossier-lead">Deux mille ans après l’éruption du Vésuve, les rouleaux carbonisés d’Herculanum commencent à rendre leurs textes. Non pas parce qu’on a trouvé le moyen de les ouvrir, mais parce qu’on apprend à les lire fermés.</p>
      <time datetime={dossier.data.publishDate.toISOString()}>{dossier.data.publishDate.toLocaleDateString('fr-FR')}</time>
    </header>
    <div class="article-content dossier-content"><Content /></div>
    {Verification && (
      <aside class="dossier-verification" aria-labelledby="verification-title">
        <p class="eyebrow">Méthode & sources</p>
        <h2 id="verification-title">Comment nous avons vérifié ce dossier</h2>
        <p class="verification-lead">Les technologies utilisées pour lire les papyrus d’Herculanum produisent autant de résultats scientifiques que de récits spectaculaires. Nous avons donc distingué les données établies, les annonces du Vesuvius Challenge, leur corroboration indépendante et les hypothèses qui restent ouvertes.</p>
        <div class="verification-content"><Verification /></div>
      </aside>
    )}
  </article>
</MainLayout>
