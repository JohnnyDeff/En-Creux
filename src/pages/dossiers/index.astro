---
import MainLayout from '../../layouts/MainLayout.astro';
import PublicationList from '../../components/PublicationList.astro';
import { getPublications } from '../../data/publications';
const publications = (await getPublications()).filter(p => p.collection === 'dossiers');
---
<MainLayout title="Dossiers">
  <section class="listing-page">
    <div class="page-intro"><p class="eyebrow">Dossiers</p><h1>Regarder plus loin. <em>En creux.</em></h1></div>
    <PublicationList publications={publications} />
  </section>
</MainLayout>
